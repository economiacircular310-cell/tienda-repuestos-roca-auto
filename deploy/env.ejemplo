# Configuración de Lenin Auto Cars. Cópialo como .env y ajústalo. NUNCA lo subas a GitHub.

# Firma de los certificados de compatibilidad. Obligatoria. Genera una con:
#   openssl rand -base64 48
# Si la cambias, los certificados ya emitidos dejan de verificarse.
LENIN_SECRET=CAMBIA-ESTO-POR-UNA-CLAVE-LARGA-Y-ALEATORIA

# Datos de la tienda
LENIN_STORE_NAME="Lenin Auto Cars"
LENIN_CURRENCY=USD
LENIN_LOCALE=es-419
LENIN_FREE_SHIPPING=99
LENIN_SHIPPING_FLAT=7.9
LENIN_EMAIL=ventas@tu-dominio.com
LENIN_WHATSAPP="+57 300 000 0000"

# Detrás de nginx, Render o Railway: la IP real del cliente viene del proxy.
LENIN_TRUST_PROXY=1
# Límite por cliente: ráfaga de 120 peticiones y 2 por segundo sostenidas.
LENIN_RATE_BURST=120
LENIN_RATE_PER_SECOND=2

# Tu inventario real (lo genera `lenin_auto importar ... --salida`). Sin esta línea se usa
# el catálogo de demostración.
#   VPS sin Docker:  LENIN_INVENTORY=/opt/lenin-auto/data/inventario.json
#   Docker:          LENIN_INVENTORY=/app/data/inventario.json
# LENIN_INVENTORY=/opt/lenin-auto/data/inventario.json
